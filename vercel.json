{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/beranda",
      "destination": "/index.html"
    },
    {
      "source": "/pelajaran/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/progres",
      "destination": "/index.html"
    },
    {
      "source": "/jadwal",
      "destination": "/index.html"
    },
    {
      "source": "/pengaturan/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/login.html"
    }
  ]
}
